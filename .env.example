# Copie para .env.local (git-ignorado) e preencha com valores reais.
# Nunca commitar chaves reais.

# API da Anthropic — usada pelo widget de chat (src/app/api/chat/route.js).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=500

# SMTP da caixa contato@viza.click (Hostinger) — usado só para o e-mail de
# notificação quando o chat qualifica um lead (handoff). Ver
# src/lib/chat/notify.js. Dados do servidor em hPanel > E-mails > viza.click
# > Conecte apps e dispositivos > Configurações avançadas.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@viza.click
SMTP_PASSWORD=

# Para quem manda o e-mail de notificação de lead (pode ser o mesmo contato@viza.click).
NOTIFY_EMAIL=
